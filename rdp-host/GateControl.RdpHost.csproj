<Project Sdk="Microsoft.NET.Sdk">
  <!--
    gc-rdp-host.exe: one process per Remote Desktop session of the Pro client. Hosts the Microsoft
    RDP ActiveX control (mstscax.dll, the engine of mstsc.exe) in its own window and talks to the app
    over stdin/stdout (one JSON message per line, see Program.cs).

    .NET Framework 4.8 (part of Windows 10 1903+ and Windows 11): no runtime is shipped.
    The interop assemblies MSTSCLib.dll / AxMSTSCLib.dll are generated by aximp.exe from the
    mstscax.dll of the build machine (.github/workflows/rdp-host.yml, scripts/build-rdp-host.ps1);
    COMReference does not work with "dotnet build" (MSB4803).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>gc-rdp-host</AssemblyName>
    <RootNamespace>GateControl.RdpHost</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
    <Product>GateControl Pro Client</Product>
    <AssemblyTitle>GateControl Remotedesktop</AssemblyTitle>
    <Copyright>Copyright 2026 GateControl</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- reference assemblies for net48, so "dotnet build" builds without the developer pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MSTSCLib"><HintPath>interop\MSTSCLib.dll</HintPath></Reference>
    <Reference Include="AxMSTSCLib"><HintPath>interop\AxMSTSCLib.dll</HintPath></Reference>
    <Reference Include="System.Web.Extensions" /> <!-- JavaScriptSerializer for the JSON line protocol -->
  </ItemGroup>

</Project>
